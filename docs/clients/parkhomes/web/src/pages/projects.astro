---
import Base from '../layouts/Base.astro';
import AgentLine from '../components/AgentLine.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Faq from '../components/Faq.astro';
import { agent } from '../data/agent.js';
import { projects, collection } from '../data/projects.js';
const available = projects.filter((p) => p.group === 'available');
const coming = projects.filter((p) => p.group === 'coming');

const faqs = [
  {
    q: 'What do "Now Selling", "Under Construction", "Register Interest" and "Planning" mean?',
    a: '"Now Selling" homes are available to purchase now. "Under Construction" developments are being built and sold ahead of completion. "Register Interest" and "Planning" developments haven’t launched for sale yet — registering gets you contacted first when they do.',
  },
  {
    q: 'Can I buy off the plan?',
    a: 'Yes — several Park Homes developments are sold before construction is complete, under a standard sale and purchase agreement. Read our guide to buying off the plans in New Zealand in the Journal for how the process works.',
  },
  {
    q: 'Is the build quality checked?',
    a: 'Yes — every development is delivered under a Licensed Building Practitioner (LBP), with disciplined quality checks at each stage from consent through to handover.',
  },
  {
    q: 'Who do I contact about a specific development?',
    a: `All enquiries across every development go through our appointed agent, ${agent.name} of ${agent.company} — ${agent.phone} or ${agent.email}.`,
  },
];
---
<Base title="Projects — Park Homes" active="projects" desc="Explore every Park Homes development across Auckland — Riverside, Howick, Castor Bay, Forrest Hill and Greenview. Now selling through to planning stage.">

  <section class="deep dark" style="padding-bottom:clamp(40px,6vw,64px)">
    <div class="wrap">
      <p class="eyebrow sec-eyebrow">{collection.subtitle}</p>
      <h1 class="sec-h">{collection.title}</h1>
      <p class="lead" style="color:#B9C2BE;margin-top:14px">{collection.body[0]}</p>
    </div>
  </section>

  <section class="tint">
    <div class="wrap twocol">
      <div>
        <p class="eyebrow sec-eyebrow">Our approach</p>
        <h2 class="group-h" style="margin-bottom:0">Carefully curated, not mass produced.</h2>
      </div>
      <div>
        {collection.body.slice(1).map((t) => <p>{t}</p>)}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow sec-eyebrow">Available now</p>
      <h2 class="group-h">Now selling &amp; under construction</h2>
      <div class="cards two">
        {available.map((p) => <ProjectCard p={p} line="listLine" />)}
      </div>

      <div class="group-sep"></div>

      <p class="eyebrow sec-eyebrow">Coming soon</p>
      <h2 class="group-h">Register your interest</h2>
      <div class="cards">
        {coming.map((p) => <ProjectCard p={p} line="listLine" />)}
      </div>
    </div>
  </section>

  <Faq items={faqs} heading="Questions about our developments" />

  <section class="dark cta">
    <div class="wrap">
      <h2>Not sure which suits you?</h2>
      <p>Sales enquiries are handled by our appointed agent.</p>
      <div><a class="arrow-cta" href="/contact/"><span class="circ">→</span><span class="lbl">Enquire</span></a></div>
      <AgentLine />
    </div>
  </section>

</Base>
