---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Park Homes" active="" desc="This page doesn't exist. Find our developments, journal and contact details from here.">

  <section class="deep dark" style="padding-bottom:clamp(40px,6vw,64px)">
    <div class="wrap">
      <p class="eyebrow sec-eyebrow">404</p>
      <h1 class="sec-h">We can't find that page</h1>
      <p class="lead" style="color:#B9C2BE;margin-top:14px">The page you're looking for doesn't exist or may have moved. Try one of these instead:</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:28px">
        <a class="btn btn-primary" href="/projects/">View our developments</a>
        <a class="btn btn-ghost" href="/journal/">Read the Journal</a>
        <a class="btn btn-ghost" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>

</Base>
